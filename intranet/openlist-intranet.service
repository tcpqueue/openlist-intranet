[Unit]
Description=OpenList Intranet File Server
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/openlist-intranet
ExecStart=/usr/bin/openlist-intranet server --data /var/lib/openlist-intranet
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
